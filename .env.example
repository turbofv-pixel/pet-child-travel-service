# 오픈API 연동 - 실제 키는 .env.local에 넣고 절대 커밋하지 마세요.

# 한국관광공사 TourAPI 서비스키
# 발급: https://www.data.go.kr → "한국관광공사_국문 관광정보 서비스" 활용신청
# (자동승인, 발급 즉시 사용 가능)
TOUR_API_KEY=

# 필요할 때만 설정 - 기본값은 src/lib/open-api/tour-api.ts 참고
# TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 지도 오픈API (Kakao/Naver 지도 등, 최종 선택 후 이름 정리 예정)
MAP_API_KEY=

# 기상청 오픈API
WEATHER_API_KEY=

# 카카오 로컬 API (주소/장소명 검색용 REST 키 - 카카오맵 JS 키와는 다른 키예요)
# 발급: https://developers.kakao.com → 애플리케이션 추가 → "REST API 키" 사용
# 없어도 동작은 합니다 (OpenStreetMap Nominatim으로 자동 대체, 정확도만 낮아짐)
KAKAO_REST_API_KEY=

# Supabase (로그인 + 여행 계획/스탬프/리워드 DB 저장)
# 발급: https://supabase.com → 프로젝트 생성 → Project Settings → API
# 없으면 로그인 기능이 숨겨지고 이 기기의 localStorage로 자동 폴백됩니다.
# DB 테이블은 supabase/schema.sql을 Supabase SQL Editor에서 한 번 실행해야 해요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
